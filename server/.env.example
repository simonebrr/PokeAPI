# Copia in .env e compila. Il file .env non va mai su GitHub.

# Email del proprietario (accesso al pannello Admin, Premium gratis). Separate da virgola.
# Se vuoto, il proprietario è il primo utente registrato.
ADMIN_EMAILS=

# Piani
PLAN_PRICE=4.99
FREE_ITEM_LIMIT=200
TRIAL_DAYS=14

# Indirizzo pubblico del sito (per i ritorni da Stripe), es. https://cardledger.it
APP_URL=

# PayPal (facoltativo): abbonamento mensile con attivazione automatica di Premium.
# 1. developer.paypal.com → Apps & Credentials → crea un'app → copia Client ID e Secret
# 2. docker compose exec php php /var/www/html/src/gestionale/paypal-setup.php → copia PAYPAL_PLAN_ID
# Prova prima in sandbox (soldi finti), poi crea le credenziali Live e metti PAYPAL_MODE=live.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_PLAN_ID=
PAYPAL_MODE=sandbox

# Stripe (facoltativo): senza chiavi, Premium si attiva a mano dal pannello Admin
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# --- Segreti (rigenerali: i vecchi erano pubblici su GitHub) ---
# Token API CardTrader: cardtrader.com → Impostazioni → API
CARDTRADER_TOKEN=
# Token bot Telegram: da @BotFather → /revoke e poi /token
TELEGRAM_BOT_TOKEN=

# --- Database ---
# Lasciare vuoto in locale (usa i valori di default).
# Su un server nuovo metti password lunghe e casuali PRIMA del primo avvio.
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Produzione (docker-compose.prod.yml) ---
# Dominio per HTTPS automatico, es. cardledger.it (vuoto = solo http sulla porta 80)
DOMAIN=
# Backup: giorni da conservare e copia esterna con rclone (es. gdrive:cardledger-backup)
BACKUP_KEEP_DAYS=30
BACKUP_REMOTE=

# --- Email (recupero password, conferma email, promemoria) ---
# Senza SMTP le email finiscono nei log: docker compose logs php
# Esempio Brevo (gratis 300/giorno): smtp-relay.brevo.com, porta 587
APP_NAME=CardLedger
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
